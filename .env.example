# ─────────────────────────────────────────────────────────────────────────────
#  FOODAY — local configuration
#
#  Copy this file to ".env" and fill in the blanks. The app runs without it;
#  every value below has a working default and is only needed for the features
#  listed against it.
#
#  .env holds secrets. Do not commit it. (.gitignore already excludes it.)
# ─────────────────────────────────────────────────────────────────────────────


# ── Database ──────────────────────────────────────────────────────────────────
# The app reads these from the environment first and only then from this file,
# so a hosting panel's own environment variables always win. Every value has a
# working default for a stock WAMP/XAMPP install, so this section is optional
# locally and required in the cloud.
#
# NOTE: a real environment variable always beats the value written here — on a
# host, set the database there rather than editing this file.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fooday_db
DB_USERNAME=root
DB_PASSWORD=

# Some hosts (e.g. Laravel Cloud) hand the database out as one URL instead. It
# is read as a fallback for whichever of the five values above is not set, so
# pasting it on its own is enough. Only mysql:// is accepted; a postgres:// URL
# is ignored rather than mis-parsed. A ?ssl-mode=... query on the URL sets the
# TLS mode below for you, which is what TiDB Cloud's URL carries.
# DATABASE_URL="mysql://user:password@host:3306/database"
# TiDB Cloud Starter/Essential, pasted straight from the console:
# DATABASE_URL="mysql://3fA9aBc.root:your-password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/fooday_db?ssl-mode=REQUIRED"


# ── Database TLS ──────────────────────────────────────────────────────────────
# TiDB Cloud Starter/Essential refuses plaintext connections, so it needs TLS.
# Leave DB_SSL_MODE unset for local MySQL/MariaDB: no SSL options are sent and
# nothing changes. For TiDB Cloud, set one of:
#
#   required         encrypt, but do not verify the server certificate
#   verify_ca        encrypt and verify the certificate chain (needs a CA)
#   verify_identity  encrypt, verify the chain and the hostname (strongest)
#
# A pasted ?ssl-mode=REQUIRED on DATABASE_URL sets this automatically. A
# verifying mode needs a CA bundle: on Linux the app finds the system one, on
# Windows download the ISRG Root X1 certificate
# (https://letsencrypt.org/certs/isrgrootx1.pem) and point DB_SSL_CA at it.
# DB_SSL_MODE=verify_identity
# DB_SSL_CA=C:/certs/isrgrootx1.pem


# ── Outbound mail ─────────────────────────────────────────────────────────────
# Needed for: two-factor sign-in codes, and any future password-reset email.
#
# MAIL_DRIVER picks the transport:
#     smtp   the built-in client (default) — no Composer needed
#     mail   PHP's own mail(), if the host already routes local mail
#     none   sending is off; two-factor enrolment is refused rather than
#            leaving an account that can never receive a code
MAIL_DRIVER=smtp

# Gmail: smtp.gmail.com
# The "From" header address. With Gmail this must be the same address as
# MAIL_SMTP_USER, or the message is rejected.
MAIL_FROM_NAME=FOODAY
MAIL_FROM=your-gmail-address@gmail.com

MAIL_SMTP_HOST=smtp.gmail.com

# 465 = TLS from the first byte (leave MAIL_SMTP_IMPLICIT_TLS=true)
# 587 = STARTTLS after connecting (set MAIL_SMTP_IMPLICIT_TLS=false)
MAIL_SMTP_PORT=465
MAIL_SMTP_IMPLICIT_TLS=true

# The Gmail address to send from.
MAIL_SMTP_USER=your-gmail-address@gmail.com

# NOT your Google account password. Google requires an App Password here:
#   Google Account > Security > 2-Step Verification > App passwords
#   (that page only appears once 2-Step Verification is on)
# The password will have spaces in it — leave the quotes on.
MAIL_SMTP_PASS="your-16-character-app-password"

# Seconds to wait for the mail server before giving up. Keep it short: a sign-in
# should not hang if the mail server is down.
MAIL_SMTP_TIMEOUT=15

# Leave true in production. Only set false for a throwaway test server using a
# self-signed certificate.
MAIL_SMTP_VERIFY_PEER=true


# ── Two-factor sign-in (MFA) ──────────────────────────────────────────────────
# How long a one-time emailed code stays valid, and how many wrong codes are
# tolerated before the challenge is thrown away and must be re-requested.
MFA_CODE_TTL_MINUTES=10
MFA_CODE_MAX_ATTEMPTS=5

# Extra secret mixed into every code hash. Optional but worth setting: it means
# a stolen database dump cannot be used to confirm a guessed code offline.
# Any long random string. Generate one with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
MFA_PEPPER=replace-with-a-long-random-string-if-you-want-one
