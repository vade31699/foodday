<?xml version="1.0" encoding="UTF-8"?>
<!--
  FOODAY — IIS rules for when THIS folder is the document root.
  The counterpart to .htaccess: refuse to serve the app's secrets
  (.env) and source data (fooday.sql, README.md, tests/) that sit in
  the same folder as index.html.
-->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env" />
          <add segment=".env.example" />
          <add segment=".git" />
          <add segment=".freebuff" />
          <add segment="tests" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
